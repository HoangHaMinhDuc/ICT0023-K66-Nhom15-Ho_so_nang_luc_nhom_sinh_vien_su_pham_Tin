:root { --main: #0F5A46; }
body { font-family: "Be Vietnam Pro", system-ui, Arial, sans-serif; line-height: 1.65; color: #14241E; background: #F5F9F6; }
h1, h2, h3, h4, h5, h6, .navbar-brand { font-weight: 800; color: var(--main); }
a { color: var(--main); }
:focus-visible { outline: 3px solid #C8372D; outline-offset: 2px; }
.text-muted-fg, .lead-dark { color: #4B625A; }
.margin-note { font-size: 1.3rem; color: #C8372D; }
img { max-width: 100%; height: auto; }
.skip-link { position: absolute; left: -999px; top: 0; background: #FFE45C; padding: .5rem 1rem; z-index: 2000; }
.skip-link:focus { left: 0; }
.site-nav { background: #F5F9F6; border-bottom: 2px solid var(--main); }
.navbar-nav .nav-link { color: #14241E; min-height: 44px; display: flex; align-items: center; }
.navbar-nav .nav-link.active { font-weight: 700; background: #FFE45C; }
.navbar-brand { white-space: normal; font-size: 1.1rem; }
.brand-logo { width: 72px; height: 72px; border-radius: 50%; object-fit: contain; }

.hero { padding: 4rem 0; }
.hero.has-bg { background-size: cover; background-position: center; }
.section { padding: 3.5rem 0; }
.section.alt { background: #E4F0E8; }
.section.warm { background: #FFF6C2; }
.stat-strip { background: var(--main); color: #fff; padding: 1.5rem 0; }
.stat-strip dl { display: flex; flex-wrap: wrap; gap: 1rem 3.5rem; margin: 0; }
.stat-strip div { display: flex; align-items: baseline; gap: .85rem; }
.stat-strip dd { margin: 0; font-size: 2.2rem; font-weight: 800; color: #FFE45C; }
.site-footer { background: var(--main); color: #fff; padding: 2rem 0; margin-top: 2rem; }

.card, .panel, .gallery-item, .page-banner, .hero-pic { background: #fff; border: 1.5px solid var(--main); border-radius: .5rem; box-shadow: 4px 4px 0 var(--main); }
.card, .gallery-item { overflow: hidden; }
.panel { padding: 1.5rem; }
.gallery-item { margin: 0; }
.gallery-item figcaption { padding: .7rem 1rem; }

.thumb { display: block; width: 100%; aspect-ratio: 16/9; object-fit: cover; border-bottom: 1.5px solid var(--main); }
.gallery-item .thumb { aspect-ratio: 3/2; }
.modal-body .thumb { border: 1.5px solid var(--main); border-radius: .5rem; margin-bottom: 1rem; }
.avatar { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex: none; }


.chip { font-size: .85rem; padding: .1rem .6rem; border: 1px solid var(--main); border-radius: 99px; background: #E4F0E8; }
.type-badge { font-size: .8rem; font-weight: 700; padding: .1rem .6rem; border: 1.5px solid var(--main); border-radius: 99px; background: #FFE45C; margin-right: .5rem; }
/* hover */
.phongto:hover {
   transform: translateY(-10px)  scale(1.1);
   transition: transform 0.3s ease;
}
.btn { min-height: 44px; font-weight: 700; box-shadow: 3px 3px 0 var(--main); }
.btn:disabled { box-shadow: none; }
.btn.btn-ink, .btn.btn-ink:hover, .btn.btn-ink:active { background: var(--main); color: #fff; border-color: var(--main); }
.btn.btn-mark, .btn.btn-mark:hover, .btn.btn-mark:active { background: #FFE45C; color: #14241E; border-color: #14241E; }
.btn.btn-outline-ink, .btn.btn-outline-ink:hover, .btn.btn-outline-ink:active { background: #fff; color: var(--main); border-color: var(--main); }
form .btn { margin: 0 .5rem .6rem 0; }

/* Bảng kỹ năng */
.sort-btn { background: none; border: 0; padding: 0; min-height: 44px; font-weight: 800; color: var(--main); text-decoration: underline dotted; }
.meter { display: inline-block; width: 110px; height: 10px; border: 1.5px solid var(--main); border-radius: 99px; overflow: hidden; vertical-align: middle; margin-right: .5rem; }
.meter i { display: block; height: 100%; background: var(--main); }

.form-label { font-weight: 700; }
.form-control, .form-select { border: 1.5px solid #B5CDBE; min-height: 44px; }
.form-control:focus, .form-select:focus { border-color: var(--main); }
.accordion-button:not(.collapsed) { background: #FFE45C; color: #14241E; }
.progress { height: 1rem; border: 1.5px solid var(--main); }
.progress-bar { background: var(--main); }
.progress-label { display: flex; justify-content: space-between; font-weight: 700; color: var(--main); }

.cv-sheet { background: #fff; border: 1.5px solid var(--main); border-left: 6px solid #C8372D; border-radius: .5rem; padding: 1.75rem; min-height: 320px; }
.cv-sheet h3 { font-size: 1rem; border-bottom: 1px solid #B5CDBE; padding-bottom: .2rem; margin-top: 1.1rem; }
.cv-photo { float: right; border-radius: 50%; object-fit: cover; border: 2px solid var(--main); margin: 0 0 .75rem 1rem; }
.cv-empty-state { display: flex; flex-direction: column; align-items: center; text-align: center; gap: .75rem; padding: 1rem 0; color: #4B625A; }
.cv-empty-state img { width: min(240px, 70%); }
.cv-empty-state p { margin: 0; }

@media (min-width: 1400px) {
  body { font-size: 1.1rem; }
  .hero { padding: 5rem 0; }
}

@media (max-width: 991.98px) {
  .hero { padding: 3rem 0; }
  .section { padding: 2.5rem 0; }
}

@media (max-width: 767.98px) {
  .page-banner { max-width: 280px; }
  .cv-sheet { padding: 1.25rem; }
}

@media (max-width: 575.98px) {
  .brand-logo { width: 48px; height: 48px; }
  .navbar-brand { font-size: 1rem; }
  .hero { padding: 2rem 0; }
  .section { padding: 2rem 0; }
  .card, .panel, .gallery-item, .page-banner, .hero-pic { box-shadow: 2px 2px 0 var(--main); }
  .btn { box-shadow: 2px 2px 0 var(--main); }
  .panel { padding: 1rem; }
  .meter { width: 70px; }
  .stat-strip dl { gap: .5rem 1.5rem; }
  .stat-strip dd { font-size: 1.8rem; }
  .cv-photo { float: none; display: block; margin: 0 0 .75rem; }
}

@media print {
  body { background: #fff; }
  .no-print, .site-nav, .site-footer, .page-banner { display: none !important; }
  .cv-sheet { border: 0; border-left: 6px solid #C8372D; }
  .section { padding: 0; }
}
